{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@baize/shared": ["packages/shared/src/index.ts"],
      "@baize/core": ["packages/core/src/index.ts"],
      "@baize/memory": ["packages/memory/src/index.ts"],
      "@baize/llm": ["packages/llm/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/desktop/src/**/*.ts",
    "apps/desktop/src/**/*.tsx",
    "apps/desktop/electron-vite.config.ts",
    "vitest.config.ts"
  ]
}
