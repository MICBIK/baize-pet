{
  "name": "baize-pet",
  "version": "0.0.0",
  "private": true,
  "description": "BaiZe (白泽) - an AI desktop pet with long-term memory and personality",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/MICBIK/baize-pet.git"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm -r --filter '!@baize/desktop' run build && pnpm --filter @baize/desktop dev",
    "build": "pnpm -r --filter '!@baize/desktop' run build && pnpm --filter @baize/desktop build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "spdx:check": "node scripts/check-spdx.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "mediabunny": "1.62.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
